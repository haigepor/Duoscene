# Copy to .env locally. Empty passwords intentionally fail validation.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# disabled: scaffolding only; /health/ready returns 503.
# mysql: require all MYSQL_* values and a reachable MySQL instance.
DATABASE_MODE=disabled
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=duoscene
MYSQL_USER=duoscene
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Development Compose only. Pin an exact patch/digest before deployment.
MYSQL_IMAGE=mysql:8.4

# Only used by npm run test:mysql; must point to an isolated test database.
DUOSCENE_TEST_DATABASE=duoscene_test_local

# Optional WebRTC TURN REST configuration. Local setup stores these in .local/voice.env.
# TURN_URLS=turn:127.0.0.1:3478?transport=tcp
# TURN_SECRET=<generate at least 32 random characters>
# TURN_RELAY_ONLY=true
