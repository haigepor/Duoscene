{
  "name": "@duoscene/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:mysql": "node --env-file-if-exists=../../.env --test --test-concurrency=1 test/mysql.integration.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/commands/cli.ts migrate",
    "account:create": "node --env-file-if-exists=../../.env src/commands/cli.ts create-user",
    "account:disable": "node --env-file-if-exists=../../.env src/commands/cli.ts disable-user",
    "sessions:prune": "node --env-file-if-exists=../../.env src/commands/cli.ts prune-sessions"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
