{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:duoscene:health-response:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "requestId"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "enum": ["alive", "ready"] } }
    }
  }
}
